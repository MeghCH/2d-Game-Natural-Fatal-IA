@startuml 3_ennemis
title 3 - Les ennemis

skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

abstract class Enemy {
  # contactDamage : int
  # scoreValue : int
  # movement : MovementStrategy
  + {abstract} attack(target : Player) : void
}

class Mosquito {
  contactDamage = 2
}

class Wasp {
  contactDamage = 6
}

class Crow {
  contactDamage = 10
}

class EvilAI {
  - phase : BossPhase
  + changePhase() : void
}

interface MovementStrategy <<Strategy>> {
  + move(e : Entity, dt : double) : void
}

class StraightMovement
class ZigzagMovement
class DiveMovement

interface BossPhase <<State>> {
  + execute(boss : EvilAI, dt : double) : void
  + next() : BossPhase
}

Enemy <|-- Mosquito
Enemy <|-- Wasp
Enemy <|-- Crow
Enemy <|-- EvilAI

Enemy o-- "1" MovementStrategy
MovementStrategy <|.. StraightMovement
MovementStrategy <|.. ZigzagMovement
MovementStrategy <|.. DiveMovement

EvilAI o-- "1" BossPhase

note right of MovementStrategy
  Chaque ennemi reçoit
  un type de déplacement
end note

note bottom of BossPhase
  L'IA change de
  comportement selon
  ses PV restants
end note

@enduml