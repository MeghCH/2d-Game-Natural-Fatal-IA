@startuml 3_ennemis
title 3 - Les ennemis

skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

abstract class Enemy {
  # contactDamage : int
  # scoreValue : int
  # movement : MovementStrategy
  + attack(target : Player) : void
  + setMovement(m : MovementStrategy) : void
}

class Mosquito {
  contactDamage = 2
  movement = ZigzagMovement
}

class Wasp {
  contactDamage = 6
  movement = StraightMovement
}

class Crow {
  contactDamage = 10
  movement = DiveMovement
}

class EvilAI {
  contactDamage = 10
  - phase : BossPhase
  - direction : int
  - thresholdsCrossed : int
  + changePhase() : void
  + reverseDirection() : void
}

interface MovementStrategy <<Strategy>> {
  + move(e : Entity, dt : double) : void
}

class StraightMovement
class ZigzagMovement
class DiveMovement

interface BossPhase <<State>> {
  + execute(boss : EvilAI, dt : double) : void
  + next() : BossPhase
  + <<default>> sweep(boss : EvilAI, dt : double, speed : double) : void
}

class CalmPhase
class AngryPhase
class BersherkPhase

Enemy <|-- Mosquito
Enemy <|-- Wasp
Enemy <|-- Crow
Enemy <|-- EvilAI

Enemy o-- "1" MovementStrategy
MovementStrategy <|.. StraightMovement
MovementStrategy <|.. ZigzagMovement
MovementStrategy <|.. DiveMovement

EvilAI o-- "1" BossPhase
BossPhase <|.. CalmPhase
BossPhase <|.. AngryPhase
BossPhase <|.. BersherkPhase
CalmPhase ..> AngryPhase : next()
AngryPhase ..> BersherkPhase : next()

note right of MovementStrategy
  Chaque ennemi reçoit
  un type de déplacement
end note

note bottom of BossPhase
  L'IA change de comportement
  selon ses PV restants :
  calme : balayage lent
  < 2/3 PV : balayage rapide
  < 1/3 PV : descend vers les joueurs
end note

@enduml
