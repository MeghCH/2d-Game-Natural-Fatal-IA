@startuml uml_entites
title Shoot'em up - Diagramme de classes : entités

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

interface Updatable {
  + update(dt : double) : void
}

interface Renderable {
  + render(gc : GraphicsContext) : void
}

interface Damageable {
  + takeDamage(amount : int) : void
  + isAlive() : boolean
}

interface HealthObserver <<Observer>> {
  + onHealthChanged(c : Character) : void
}

interface MovementStrategy <<Strategy>> {
  + move(e : Entity, dt : double) : void
}

abstract class Entity {
  # x : double
  # y : double
  # width : double
  # height : double
  + getX() : double
  + getY() : double
  + getWidth() : double
  + getHeight() : double
  + setX(x : double) : void
  + setY(y : double) : void
  + collidesWith(other : Entity) : boolean
}

abstract class Character {
  # hp : int
  # maxHp : int
  - observers : List<HealthObserver>
  + takeDamage(amount : int) : void
  + heal(amount : int) : void
  + isAlive() : boolean
  + getHp() : int
  + getMaxHp() : int
  + addObserver(o : HealthObserver) : void
  # notifyObservers() : void
}

class Player {
  + {static} WIDTH : double = 48
  + {static} HEIGHT : double = 64
  - {static} SPEED : double = 300
  - {static} MAX_HP : int = 30
  - {static} IDLE : Animation
  - {static} ATTACK : Animation
  - playerId : int
  - score : int
  - animationTime : double
  - weapon : Weapon
  - controls : InputController
  + shoot() : List<Projectile>
  + getPlayerId() : int
  + getControls() : InputController
  + getScore() : int
  + addScore(points : int) : void
}

class InputController {
  - up : Set<KeyCode>
  - down : Set<KeyCode>
  - left : Set<KeyCode>
  - right : Set<KeyCode>
  - shoot : Set<KeyCode>
  - pressed : Set<KeyCode>
  + {static} player1() : InputController
  + {static} player2() : InputController
  + keyPressed(code : KeyCode) : void
  + keyReleased(code : KeyCode) : void
  + isUp() : boolean
  + isDown() : boolean
  + isLeft() : boolean
  + isRight() : boolean
  + isShooting() : boolean
  + clear() : void
  - isAnyPressed(keys : Set<KeyCode>) : boolean
}

class PlayerStatusPanel

abstract class Enemy {
  # contactDamage : int
  # scoreValue : int
  # movement : MovementStrategy
  # animationTime : double
  + attack(target : Player) : void
  + getContactDamage() : int
  + getScoreValue() : int
  + setMovement(m : MovementStrategy) : void
  + getMovement() : MovementStrategy
  + getAnimationTime() : double
}

class Mosquito {
  + {static} SIZE : double = 32
  - {static} MAX_HP : int = 2
  - {static} DAMAGE : int = 2
  - {static} SCORE : int = 100
  - {static} FLY_A : Animation
  - {static} FLY_B : Animation
  - variant : int
  + getVariant() : int
}

class Wasp {
  + {static} SIZE : double = 32
  - {static} MAX_HP : int = 3
  - {static} DAMAGE : int = 6
  - {static} SCORE : int = 200
  - {static} FLY_A : Animation
  - {static} FLY_B : Animation
  - variant : int
  + getVariant() : int
}

class Crow {
  + {static} SIZE : double = 40
  - {static} MAX_HP : int = 5
  - {static} DAMAGE : int = 10
  - {static} SCORE : int = 300
  - {static} FLY_A : Animation
  - {static} FLY_B : Animation
  - variant : int
  + getVariant() : int
}

class EvilAI {
  + {static} SIZE : double = 80
  - {static} MAX_HP : int = 100
  - {static} DAMAGE : int = 10
  - {static} SCORE : int = 1000
  - {static} CALM : Animation
  - {static} ENRAGED : Animation
  - phase : BossPhase
  - direction : int
  - thresholdsCrossed : int
  + changePhase() : void
  + getPhase() : BossPhase
  + getDirection() : int
  + reverseDirection() : void
}

interface BossPhase <<State>> {
  + execute(boss : EvilAI, dt : double) : void
  + next() : BossPhase
  + <<default>> sweep(boss : EvilAI, dt : double, speed : double) : void
}

class CalmPhase {
  - {static} SPEED : double = 60
}

class AngryPhase {
  - {static} SPEED : double = 140
}

class BersherkPhase {
  - {static} SPEED : double = 80
}

class Projectile {
  + {static} SIZE : double = 16
  - {static} P1_FLIGHT : Animation
  - {static} P2_FLIGHT : Animation
  - vx : double
  - vy : double
  - damage : int
  - owner : Character
  - active : boolean
  - animationTime : double
  + isOutOfScreen() : boolean
  + destroy() : void
  + isActive() : boolean
  + getDamage() : int
  + getOwner() : Character
}

class Potion {
  + {static} SIZE : double = 32
  - {static} FALL_SPEED : double = 120
  - {static} HEAL_AMOUNT : int = 10
  - {static} FALLING : Animation
  - {static} COLLECTED : Animation
  - active : boolean
  - collected : boolean
  - animationTime : double
  - collectTime : double
  + isOutOfScreen() : boolean
  + collect(c : Character) : void
  + isCollected() : boolean
  + isActive() : boolean
}

class Weapon {
  - {static} FIRE_DELAY : double = 0.2
  - {static} BULLET_SPEED : double = 600
  - {static} DAMAGE : int = 1
  - cooldown : double
  + canFire() : boolean
  + fire(shooter : Character) : List<Projectile>
}

class StraightMovement {
  - {static} SPEED : double = 100
}

class ZigzagMovement {
  - {static} SPEED : double = 100
  - {static} AMPLITUDE : double = 80
  - {static} FREQUENCY : double = 0.05
}

class DiveMovement {
  - {static} SPEED : double = 250
}

Updatable <|.. Entity
Renderable <|.. Entity
Damageable <|.. Character

Entity <|-- Character
Entity <|-- Projectile
Entity <|-- Potion
Character <|-- Player
Character <|-- Enemy

Enemy <|-- Mosquito
Enemy <|-- Wasp
Enemy <|-- Crow
Enemy <|-- EvilAI

Player *-- "1" Weapon
Player o-- "1" InputController
Weapon ..> Projectile : <<create>>
Updatable <|.. Weapon
Potion ..> Character : soigne
Projectile --> "1" Character : owner

Enemy o-- "1" MovementStrategy
MovementStrategy <|.. StraightMovement
MovementStrategy <|.. ZigzagMovement
MovementStrategy <|.. DiveMovement

EvilAI o-- "1" BossPhase
BossPhase <|.. CalmPhase
BossPhase <|.. AngryPhase
BossPhase <|.. BersherkPhase
CalmPhase ..> AngryPhase : next()
AngryPhase ..> BersherkPhase : next()

Character o-- "*" HealthObserver
HealthObserver <|.. PlayerStatusPanel

note right of Potion
  Tombe du haut de l'écran
  et rend 10 PV au joueur
  qui l'attrape (une seule fois),
  puis joue son animation
  de ramassage
end note

note right of Enemy
  Dégâts au contact :
  moustique = 2
  guêpe = 6
  corbeau = 10
  IA maléfique = 10
end note

note bottom of PlayerStatusPanel
  Détail dans
  Uml_structure_jeu
end note

@enduml
