@startuml uml_entites
title Shoot'em up - Diagramme de classes : entités

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

interface Updatable {
  + update(dt : double) : void
}

interface Renderable {
  + render(gc : GraphicsContext) : void
}

interface Damageable {
  + takeDamage(amount : int) : void
  + isAlive() : boolean
}

interface HealthObserver <<Observer>> {
  + onHealthChanged(c : Character) : void
}

interface MovementStrategy <<Strategy>> {
  + move(e : Entity, dt : double) : void
}

abstract class Entity {
  # x : double
  # y : double
  # width : double
  # height : double
  + getX() : double
  + getY() : double
  + getWidth() : double
  + getHeight() : double
  + setX(x : double) : void
  + setY(y : double) : void
  + collidesWith(other : Entity) : boolean
}

abstract class Character {
  # hp : int
  # maxHp : int
  - observers : List<HealthObserver>
  + takeDamage(amount : int) : void
  + heal(amount : int) : void
  + isAlive() : boolean
  + addObserver(o : HealthObserver) : void
  # notifyObservers() : void
}

class Player {
  + {static} SIZE : double
  - playerId : int
  - score : int
  - weapon : Weapon
  - controls : InputController
  + shoot() : List<Projectile>
  + getControls() : InputController
  + getScore() : int
  + addScore(points : int) : void
}

class InputController {
  - up : Set<KeyCode>
  - down : Set<KeyCode>
  - left : Set<KeyCode>
  - right : Set<KeyCode>
  - shoot : Set<KeyCode>
  - pressed : Set<KeyCode>
  + {static} player1() : InputController
  + {static} player2() : InputController
  + keyPressed(code : KeyCode) : void
  + keyReleased(code : KeyCode) : void
  + isUp() : boolean
  + isDown() : boolean
  + isLeft() : boolean
  + isRight() : boolean
  + isShooting() : boolean
  + clear() : void
}

abstract class Enemy {
  # contactDamage : int
  # scoreValue : int
  # movement : MovementStrategy
  + getContactDamage() : int
  + setMovement(m : MovementStrategy) : void
  + {abstract} attack(target : Player) : void
}

class Mosquito {
  contactDamage = 2
}

class Wasp {
  contactDamage = 6
}

class Crow {
  contactDamage = 10
}

class EvilAI {
  - phase : BossPhase
  + changePhase() : void
}

interface BossPhase <<State>> {
  + execute(boss : EvilAI, dt : double) : void
  + next() : BossPhase
}

class Projectile {
  - vx : double
  - vy : double
  - damage : int
  - owner : Character
  - active : boolean
  + isOutOfScreen() : boolean
  + destroy() : void
  + isActive() : boolean
  + getDamage() : int
  + getOwner() : Character
}

class Potion {
  + {static} SIZE : double
  - {static} FALL_SPEED : double
  - {static} HEAL_AMOUNT : int
  - active : boolean
  - animationTime : double
  + update(dt : double) : void
  + render(gc : GraphicsContext) : void
  + isOutOfScreen() : boolean
  + collect(c : Character) : void
  + isActive() : boolean
class Bonus {
  + {static} SIZE : double
  + {static} HEAL : int
  + collect(player : Player) : void
}

class Weapon {
  - cooldown : double
  + canFire() : boolean
  + fire(shooter : Character) : List<Projectile>
}

class StraightMovement
class ZigzagMovement
class DiveMovement

Updatable <|.. Entity
Renderable <|.. Entity
Damageable <|.. Character

Entity <|-- Character
Entity <|-- Projectile
Entity <|-- Bonus
Character <|-- Player
Character <|-- Enemy

Enemy <|-- Mosquito
Enemy <|-- Wasp
Enemy <|-- Crow
Enemy <|-- EvilAI

Player *-- "1" Weapon
Player *-- "1" InputController
Weapon ..> Projectile : <<create>>
Updatable <|.. Weapon
Bonus ..> Player : soigne
Projectile --> "1" Character : owner

Enemy o-- "1" MovementStrategy
MovementStrategy <|.. StraightMovement
MovementStrategy <|.. ZigzagMovement
MovementStrategy <|.. DiveMovement

EvilAI o-- "1" BossPhase
Character o-- "*" HealthObserver

Entity <|-- Potion
Potion ..> Character : soigne

note right of Potion
  Tombe du haut de l'écran
  et rend des PV au joueur
  qui la ramasse
end note

note right of Enemy
  Dégâts au contact :
  moustique = 2
  guêpe = 6
  corbeau = 10
end note

@enduml