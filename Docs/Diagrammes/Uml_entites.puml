@startuml uml_entites
title Shoot'em up - Diagramme de classes : entités

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

interface Updatable {
  + update(dt : double) : void
}

interface Renderable {
  + render(gc : GraphicsContext) : void
}

interface Damageable {
  + takeDamage(amount : int) : void
  + isAlive() : boolean
}

interface HealthObserver <<Observer>> {
  + onHealthChanged(c : Character) : void
}

interface MovementStrategy <<Strategy>> {
  + move(e : Entity, dt : double) : void
}

abstract class Entity {
  # x : double
  # y : double
  # width : double
  # height : double
  + getX() : double
  + getY() : double
  + getWidth() : double
  + getHeight() : double
  + setX(x : double) : void
  + setY(y : double) : void
  + collidesWith(other : Entity) : boolean
}

abstract class Character {
  # hp : int
  # maxHp : int
  - observers : List<HealthObserver>
  + takeDamage(amount : int) : void
  + heal(amount : int) : void
  + isAlive() : boolean
  + getHp() : int
  + getMaxHp() : int
  + addObserver(o : HealthObserver) : void
  # notifyObservers() : void
}

class Player {
  + {static} WIDTH : double
  + {static} HEIGHT : double
  - {static} IDLE : Animation
  - {static} ATTACK : Animation
  - playerId : int
  - score : int
  - animationTime : double
  - weapon : Weapon
  - controls : InputController
  + shoot() : List<Projectile>
  + getPlayerId() : int
  + getControls() : InputController
  + getScore() : int
  + addScore(points : int) : void
}

class InputController {
  - up : Set<KeyCode>
  - down : Set<KeyCode>
  - left : Set<KeyCode>
  - right : Set<KeyCode>
  - shoot : Set<KeyCode>
  - pressed : Set<KeyCode>
  + {static} player1() : InputController
  + {static} player2() : InputController
  + keyPressed(code : KeyCode) : void
  + keyReleased(code : KeyCode) : void
  + isUp() : boolean
  + isDown() : boolean
  + isLeft() : boolean
  + isRight() : boolean
  + isShooting() : boolean
  + clear() : void
}

abstract class Enemy {
  # contactDamage : int
  # scoreValue : int
  # movement : MovementStrategy
  + attack(target : Player) : void
  + getContactDamage() : int
  + getScoreValue() : int
  + setMovement(m : MovementStrategy) : void
  + getMovement() : MovementStrategy
}

class Mosquito {
  + {static} SIZE : double
  contactDamage = 2
}

class Wasp {
  + {static} SIZE : double
  contactDamage = 6
}

class Crow {
  + {static} SIZE : double
  contactDamage = 10
}

class EvilAI {
  + {static} SIZE : double
  - phase : BossPhase
  - direction : int
  - thresholdsCrossed : int
  + changePhase() : void
  + getPhase() : BossPhase
  + getDirection() : int
  + reverseDirection() : void
}

interface BossPhase <<State>> {
  + execute(boss : EvilAI, dt : double) : void
  + next() : BossPhase
  + sweep(boss : EvilAI, dt : double, speed : double) : void
}

class CalmPhase
class AngryPhase
class BersherkPhase

class Projectile {
  + {static} SIZE : double
  - {static} P1_FLIGHT : Animation
  - {static} P2_FLIGHT : Animation
  - vx : double
  - vy : double
  - damage : int
  - owner : Character
  - active : boolean
  - animationTime : double
  + isOutOfScreen() : boolean
  + destroy() : void
  + isActive() : boolean
  + getDamage() : int
  + getOwner() : Character
}

class Potion {
  + {static} SIZE : double
  - {static} HEAL_AMOUNT : int
  - {static} FALLING : Animation
  - {static} COLLECTED : Animation
  - active : boolean
  - collected : boolean
  - animationTime : double
  - collectTime : double
  + isOutOfScreen() : boolean
  + collect(c : Character) : void
  + isCollected() : boolean
  + isActive() : boolean
}

class Weapon {
  - cooldown : double
  + canFire() : boolean
  + fire(shooter : Character) : List<Projectile>
}

class StraightMovement
class ZigzagMovement
class DiveMovement

Updatable <|.. Entity
Renderable <|.. Entity
Damageable <|.. Character

Entity <|-- Character
Entity <|-- Projectile
Entity <|-- Potion
Character <|-- Player
Character <|-- Enemy

Enemy <|-- Mosquito
Enemy <|-- Wasp
Enemy <|-- Crow
Enemy <|-- EvilAI

Player *-- "1" Weapon
Player *-- "1" InputController
Weapon ..> Projectile : <<create>>
Updatable <|.. Weapon
Potion ..> Character : soigne
Projectile --> "1" Character : owner

Enemy o-- "1" MovementStrategy
MovementStrategy <|.. StraightMovement
MovementStrategy <|.. ZigzagMovement
MovementStrategy <|.. DiveMovement

EvilAI o-- "1" BossPhase
BossPhase <|.. CalmPhase
BossPhase <|.. AngryPhase
BossPhase <|.. BersherkPhase

Character o-- "*" HealthObserver

note right of Potion
  Tombe du haut de l'écran
  et rend 10 PV au joueur
  qui l'attrape (une seule fois),
  puis joue son animation
  de ramassage
end note

note right of Enemy
  Dégâts au contact :
  moustique = 2
  guêpe = 6
  corbeau = 10
  IA maléfique = 10
end note

@enduml
