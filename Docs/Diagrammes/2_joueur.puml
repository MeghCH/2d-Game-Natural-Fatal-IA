@startuml 2_joueur
title 2 - Le joueur

skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

interface Updatable {
  + update(dt : double) : void
}

interface Renderable {
  + render(gc : GraphicsContext) : void
}

abstract class Entity {
  # x : double
  # y : double
  # width : double
  # height : double
  + getX() : double
  + getY() : double
  + getWidth() : double
  + getHeight() : double
  + setX(x : double) : void
  + setY(y : double) : void
  + collidesWith(other : Entity) : boolean
}

abstract class Character {
  # hp : int
  - observers : List<HealthObserver>
  + takeDamage(amount : int) : void
  + heal(amount : int) : void
  + addObserver(o : HealthObserver) : void
  # notifyObservers() : void
}

class Player {
  + {static} WIDTH : double
  + {static} HEIGHT : double
  - playerId : int
  - score : int
  + shoot() : List<Projectile>
  + getControls() : InputController
  + getScore() : int
  + addScore(points : int) : void
}

class InputController {
  - bindings : Map<Action, Set<KeyCode>>
  - pressed : Set<KeyCode>
  + {static} player1() : InputController
  + {static} player2() : InputController
  + getKeys(a : Action) : Set<KeyCode>
  + setKeys(a : Action, keys : Set<KeyCode>) : void
  + removeKey(code : KeyCode) : Action
  + keyPressed(code : KeyCode) : void
  + keyReleased(code : KeyCode) : void
  + isPressed(a : Action) : boolean
  + isUp() : boolean
  + isDown() : boolean
  + isLeft() : boolean
  + isRight() : boolean
  + isShooting() : boolean
  + clear() : void
}

enum Action {
  UP
  DOWN
  LEFT
  RIGHT
  SHOOT
}

interface Updatable {
  + update(dt : double) : void
}

class Weapon {
  - cooldown : double
  + canFire() : boolean
  + fire(shooter : Character) : List<Projectile>
}

class Projectile {
  - damage : int
}

interface HealthObserver <<Observer>> {
  + onHealthChanged(c : Character) : void
}

class PlayerStatusPanel {
  + track(player : Player) : void
  + onHealthChanged(c : Character) : void
}

Updatable  <|.. Entity
Renderable <|.. Entity
Entity <|-- Character
Character <|-- Player
Player o-- "1" InputController
Player *-- "1" Weapon
Weapon ..> Projectile : crée
Updatable <|.. Weapon
Character o-- "*" HealthObserver
HealthObserver <|.. PlayerStatusPanel
InputController --> "*" Action : bindings

note bottom of InputController
  Joueur 1 : ZQSD (ou WASD) + espace
  Joueur 2 : flèches + entrée
  Les touches sont modifiables dans
  ControlsState et conservées par Game.
end note

note bottom of PlayerStatusPanel
  Prévenu à chaque
  changement de PV
  (coup ou soin),
  clignote seulement
  quand les PV baissent
end note

@enduml
