@startuml uml_structure_jeu
title Shoot'em up - Diagramme de classes : structure du jeu

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 130
skinparam ranksep 150
hide empty members

abstract class Application <<JavaFX>>
abstract class AnimationTimer <<JavaFX>>

class Main {
  + start(stage : Stage) : void
  + {static} main(args : String[]) : void
}

class Game {
- currentState : GameState

- loop : GameLoop

  + {static} WIDTH : int = 960
  + {static} HEIGHT : int = 540
  + start(loop : GameLoop) : void
  + stop() : void
  + setState(s : GameState) : void
  + getCurrentState() : GameState
  + update(dt : double) : void
  + render(gc : GraphicsContext) : void
  + keyPressed(code : KeyCode) : void
  + keyReleased(code : KeyCode) : void
- state() : GameState

}

class GameLoop {
- game : Game

- gc : GraphicsContext

- last : long

- running : boolean

  + handle(now : long) : void
  + start() : void
  + stop() : void
  + isRunning() : boolean
}

interface GameState <<State>> {
  + enter() : void
  + update(dt : double) : void
  + render(gc : GraphicsContext) : void
  + keyPressed(code : KeyCode) : void
  + keyReleased(code : KeyCode) : void
}

class MenuState {
- {static} INPUT_DELAY : double = 1.0

- game : Game

- background : Starfield

- elapsed : double

- drawGrid(gc : GraphicsContext) : void

- drawScanlines(gc : GraphicsContext) : void

}

class PauseState {
- game : Game

- previousState : GameState

}

class GameOverState {
- {static} INPUT_DELAY : double = 1.0

- game : Game

- score : int

- elapsed : double

}

class PlayingState {
- game : Game

- players : List<Player>

- projectiles : List<Projectile>

- levelManager : LevelManager

- statusPanel : PlayerStatusPanel

- bossHealthBar : BossHealthBar

- potions : List<Potion>

- potionSpawner : PotionSpawner

  + getPlayers() : List<Player>
  + getProjectiles() : List<Projectile>
  + getPotions() : List<Potion>
  + getLevelManager() : LevelManager
  + getBossHealthBar() : BossHealthBar
- addPlayer(player : Player) : void

- handleCollisions() : void

- updatePotions(dt : double) : void

- findBoss() : EvilAI

- anyPlayerAlive() : boolean

- totalScore() : int

}

class LevelManager {
- levels : List<Level>

- currentIndex : int

  + update(dt : double) : void
  + nextLevel() : boolean
  + isFinished() : boolean
  + getCurrentLevel() : Level
  + getCurrentLevelNumber() : int
  + getBackgroundColor() : String
}

abstract class Level <<Template Method>> {
  # waves : Queue<Wave>
  # activeEnemies : List<Enemy>
- factory : EnemyFactory

  + start() : void
  + update(dt : double) : void
  # {abstract} buildWaves() : void
  + {abstract} getBackgroundColor() : String
  + isCompleted() : boolean
  + getActiveEnemies() : List<Enemy>
}

class MosquitoLevel {
  # buildWaves() : void
  + getBackgroundColor() : String
}

class WaspLevel {
  # buildWaves() : void
  + getBackgroundColor() : String
}

class CrowLevel {
  # buildWaves() : void
  + getBackgroundColor() : String
}

class BossLevel {
  # buildWaves() : void
  + getBackgroundColor() : String
}

class Wave {
- type : EnemyType

- count : int

  + spawn(f : EnemyFactory) : List<Enemy>
  + getType() : EnemyType
  + getCount() : int
}

class TutorialManager {
- TutorialManager()

  + {static} createProgression(f : EnemyFactory) : LevelManager
}

class Player
class Projectile
class Potion
abstract class Enemy
class Mosquito
class Wasp
class Crow
class EvilAI

class EnemyFactory <<Factory>> {
  + create(t : EnemyType, x : double, y : double) : Enemy
}

enum EnemyType {
  MOSQUITO
  WASP
  CROW
  EVIL_AI
}

interface HealthObserver <<Observer>> {
  + onHealthChanged(c : Character) : void
}

interface Updatable {
  + update(dt : double) : void
}

interface Renderable {
  + render(gc : GraphicsContext) : void
}

class PlayerStatusPanel {
- {static} FLASH_DURATION : double = 0.3

- {static} BAR_WIDTH : double = 200

- {static} BAR_HEIGHT : double = 16

- {static} MARGIN : double = 20

- players : List<Player>

- flashTimers : Map<Character, Double>

- lastKnownHp : Map<Character, Integer>

  + track(player : Player) : void
  + onHealthChanged(c : Character) : void
  + update(dt : double) : void
  + isFlashing(c : Character) : boolean
  + render(gc : GraphicsContext) : void
}

class BossHealthBar {
- {static} BAR_WIDTH : double = 300

- {static} BAR_HEIGHT : double = 14

- boss : EvilAI

  + setBoss(boss : EvilAI) : void
  + getBoss() : EvilAI
  + render(gc : GraphicsContext) : void
}

class Starfield {
- {static} STAR_COUNT : int = 120

- {static} SLOW_SPEED : double = 20

- {static} FAST_SPEED : double = 60

- {static} FAST_COLOR : Color

- {static} SLOW_COLOR : Color

- height : int

- stars : List<Star>

  + update(dt : double) : void
  + render(gc : GraphicsContext) : void
  + getStarCount() : int
  + getStars() : List<Star>
}

class "Starfield.Star" as Star {
- x : double

- y : double

- fast : boolean

  + getX() : double
  + getY() : double
  + isFast() : boolean
}

class PotionSpawner {
- {static} MIN_DELAY : double = 6

- {static} MAX_DELAY : double = 12

- random : Random

- timer : double

  + update(dt : double) : List<Potion>
- nextDelay() : double

}

class AssetManager <<Singleton>> {
- {static} instance : AssetManager

- images : Map<String, Image>

- AssetManager()

  + {static} getInstance() : AssetManager
  + getImage(path : String) : Image
}

class Animation {
- frameWidth : double

- frameHeight : double

- row : int

- col : int

- frames : int

- fps : double

- loop : boolean

  + Animation(frameWidth : double, frameHeight : double, row : int, col : int, frames : int, fps : double, loop : boolean)
  + Animation(frameWidth : double, frameHeight : double, row : int, frames : int, fps : double)
  + frameIndex(time : double) : int
  + isFinished(time : double) : boolean
  + draw(gc : GraphicsContext, sheet : Image, time : double, x : double, y : double, width : double, height : double) : void
}

Application <|-- Main
AnimationTimer <|-- GameLoop
Main ..> Game : <<create>>
Main ..> GameLoop : <<create>>

Game o-- "1" GameLoop
GameLoop --> "1" Game : update / render
Game o-- "1" GameState

GameState <|.. MenuState
GameState <|.. PlayingState
GameState <|.. PauseState
GameState <|.. GameOverState
PauseState o-- "1" GameState : previousState

MenuState *-- "1" Starfield : background
PlayingState *-- "*" Player
PlayingState *-- "*" Projectile
PlayingState *-- "*" Potion
PlayingState o-- "1" PotionSpawner
PlayingState *-- "1" PlayerStatusPanel
PlayingState *-- "1" BossHealthBar
PlayingState *-- "1" LevelManager
PlayingState ..> TutorialManager : <<use>>
PotionSpawner ..> Potion : <<create>>

LevelManager *-- "1..*" Level
Level <|-- MosquitoLevel
Level <|-- WaspLevel
Level <|-- CrowLevel
Level <|-- BossLevel

TutorialManager ..> LevelManager : <<create>>
TutorialManager ..> EnemyFactory : <<use>>

Level *-- "*" Wave
Level o-- "*" Enemy : activeEnemies
Level --> "1" EnemyFactory : factory
Wave ..> EnemyFactory : <<use>>
Wave --> "1" EnemyType
EnemyFactory ..> EnemyType
EnemyFactory ..> Enemy : <<create>>

Enemy <|-- Mosquito
Enemy <|-- Wasp
Enemy <|-- Crow
Enemy <|-- EvilAI

HealthObserver <|.. PlayerStatusPanel
Updatable <|.. PlayerStatusPanel
Renderable <|.. PlayerStatusPanel
Renderable <|.. BossHealthBar
BossHealthBar --> "0..1" EvilAI : suit
PlayerStatusPanel o-- "*" Player : players

Updatable <|.. Starfield
Renderable <|.. Starfield
Starfield *-- "*" Star : stars

Player --> "2" Animation : IDLE, ATTACK
Projectile --> "2" Animation : P1_FLIGHT, P2_FLIGHT
Potion --> "2" Animation : FALLING, COLLECTED
Mosquito --> "2" Animation : FLY_A, FLY_B
Wasp --> "2" Animation : FLY_A, FLY_B
Crow --> "2" Animation : FLY_A, FLY_B
EvilAI --> "2" Animation : CALM, ENRAGED
Player ..> AssetManager
Projectile ..> AssetManager
Potion ..> AssetManager
Mosquito ..> AssetManager
Wasp ..> AssetManager
Crow ..> AssetManager
EvilAI ..> AssetManager

note right of Level
  start() et update() sont final :
  le déroulement est figé, seules
  buildWaves() et getBackgroundColor()
  changent d'un niveau à l'autre
end note

note bottom of MosquitoLevel : Niveau 1 - moustiques (3, 6, 10)
note bottom of WaspLevel : Niveau 2 - guêpes (3, 5, 8)
note bottom of CrowLevel : Niveau 3 - corbeaux (3, 5, 8)
note bottom of BossLevel : Niveau 4 - IA maléfique (1)

note right of GameState
  Menu → Partie : Entrée (après 1 s)
  Partie → Pause : Échap
  Pause → Partie : Échap
  Partie → Game Over : fin de partie
  Game Over → Partie : Entrée (après 1 s)
  Game Over → Menu : Échap (après 1 s)
end note

note bottom of PlayingState
  Collisions gérées
  dans PlayingState
  (handleCollisions)
end note

note bottom of AssetManager
  <<use>> : chaque classe qui a un sprite
  charge sa planche avec
  getInstance().getImage()
end note

note bottom of PotionSpawner
  Fait tomber une potion
  toutes les 6 à 12 s.
  Peut être injecté dans
  PlayingState (Random fixé
  pour les tests)
end note

@enduml