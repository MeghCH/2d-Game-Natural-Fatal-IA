@startuml uml_structure_jeu
title Shoot'em up - Diagramme de classes : structure du jeu

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

class Game {
  - currentState : GameState
  - loop : GameLoop
  + setState(s : GameState) : void
  + start() : void
}

class GameLoop {
  - running : boolean
  + handle(now : long) : void
}

interface GameState <<State>> {
  + enter() : void
  + update(dt : double) : void
  + render(gc : GraphicsContext) : void
  + handleInput(e : InputEvent) : void
}

class MenuState
class PauseState
class GameOverState

class PlayingState {
  - players : List<Player>
  - levelManager : LevelManager
  - collisions : CollisionManager
  - hud : Hud
}

class LevelManager {
  - levels : List<Level>
  - currentIndex : int
  + getCurrentLevel() : Level
  + nextLevel() : boolean
}

abstract class Level <<Template Method>> {
  # waves : Queue<Wave>
  # activeEnemies : List<Enemy>
  + update(dt : double) : void
  # {abstract} buildWaves() : void
  + isCompleted() : boolean
}

class TutorialLevel {
  # buildWaves() : void
}
note bottom of TutorialLevel : Niveau 1 - moustiques

class WaspLevel {
  # buildWaves() : void
}
note bottom of WaspLevel : Niveau 2 - guêpes

class CrowLevel {
  # buildWaves() : void
}
note bottom of CrowLevel : Niveau 3 - corbeaux

class BossLevel {
  # buildWaves() : void
}
note bottom of BossLevel : Niveau 4 - IA maléfique

class Wave {
  - type : EnemyType
  - count : int
  - spawnDelay : double
  + spawn(f : EnemyFactory) : List<Enemy>
}

class EnemyFactory <<Factory>> {
  + create(t : EnemyType, x : double, y : double) : Enemy
}

enum EnemyType {
  MOSQUITO
  WASP
  CROW
  EVIL_AI
}

class CollisionManager {
  + check(a : List<Entity>, b : List<Entity>) : void
}

interface HealthObserver <<Observer>> {
  + onHealthChanged(c : Character) : void
}

class Hud {
  + onHealthChanged(c : Character) : void
  + render(gc : GraphicsContext) : void
}

Game *-- "1" GameLoop
Game o-- "1" GameState

GameState <|.. MenuState
GameState <|.. PlayingState
GameState <|.. PauseState
GameState <|.. GameOverState

PlayingState *-- "1" LevelManager
PlayingState *-- "1" CollisionManager
PlayingState *-- "1" Hud

LevelManager *-- "4" Level
Level <|-- TutorialLevel
Level <|-- WaspLevel
Level <|-- CrowLevel
Level <|-- BossLevel

Level *-- "*" Wave
Wave ..> EnemyFactory : <<use>>
EnemyFactory ..> EnemyType

HealthObserver <|.. Hud

@enduml@startuml uml_structure_jeu
